# Browser (Vite) — prefix with VITE_
# Production Turnstile site key (Cloudflare dashboard → Turnstile)
VITE_TURNSTILE_SITE_KEY=

# Signup API path
VITE_SIGNUP_API_URL=/api/subscribe

# Local dev uses Cloudflare test site keys automatically (see SignupPopup.jsx).
# Set this only to test your real production keys on localhost:
# VITE_TURNSTILE_USE_PRODUCTION=true
