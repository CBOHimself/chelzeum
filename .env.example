# Browser (Vite) — prefix with VITE_
VITE_TURNSTILE_SITE_KEY=
VITE_SIGNUP_API_URL=/api/subscribe

# Local dev uses Cloudflare test Turnstile keys automatically (see SignupPopup.jsx).
# VITE_TURNSTILE_USE_PRODUCTION=true

# Server — used by npm run dev (vite.subscribe-api.js) and Cloudflare Worker secrets
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOW_TEST_KEYS=true

# Resend delivers signup notifications to SIGNUP_TO_EMAIL
# With onboarding@resend.dev (no custom domain), Resend only allows sending TO your Resend account email.
# After verifying chelzeum.net at resend.com/domains, use signup@chelzeum.net as RESEND_FROM_EMAIL and any recipient.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Chelzeum Signups <onboarding@resend.dev>
SIGNUP_TO_EMAIL=chelzeum@gmail.com
